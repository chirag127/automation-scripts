# Discord bot token — get from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Microsoft Bing Search API key — Azure Cognitive Services
BING_API_KEY=your_bing_api_key_here

# Pocket consumer key — from https://getpocket.com/developer/apps/
POCKET_CONSUMER_KEY=your_pocket_consumer_key_here

# Pocket access token — obtained via OAuth flow with consumer key
POCKET_ACCESS_TOKEN=your_pocket_access_token_here

# Pocket OAuth request token — temporary, used during OAuth flow
POCKET_REQUEST_TOKEN=your_pocket_request_token_here

# OpenAI API key — from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
